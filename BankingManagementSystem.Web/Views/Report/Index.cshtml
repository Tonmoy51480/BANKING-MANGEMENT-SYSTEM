@model BankingManagementSystem.Core.DTOs.DailyBankingSummaryDto
@{
    ViewData["Title"] = "Daily Banking Summary Report";
}

<div class="page-header no-print">
    <div>
        <h1 class="page-title">Daily Banking Summary Report</h1>
        <div class="page-subtitle">Consolidated daily liquidity balance movements and counter throughput</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Transactions" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-table me-1"></i> Transaction Report
        </a>
        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print Summary
        </button>
    </div>
</div>

<!-- Date Picker (No print) -->
<div class="bank-card p-3 mb-4 no-print">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white">Select Date:</span>
                <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Generate Report</button>
        </div>
    </form>
</div>

<!-- Report Sheet -->
<div class="bank-card p-4">
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-0">SecureBank Core Enterprise</h4>
            <div class="small text-muted">Daily Executive Liquidity Summary & Audit Digest</div>
        </div>
        <div class="text-end">
            <div class="small text-muted">Reporting Day</div>
            <div class="fw-bold fs-5 text-primary">@Model.Date.ToString("dddd, MMMM dd, yyyy")</div>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="p-3 rounded border bg-light">
                <div class="small text-muted">Gross Deposits</div>
                <div class="fs-4 fw-bold text-success font-mono">@Model.TotalDeposits.ToString("C2")</div>
                <div class="small text-muted">@Model.DepositCount deposit transactions</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 rounded border bg-light">
                <div class="small text-muted">Gross Withdrawals</div>
                <div class="fs-4 fw-bold text-danger font-mono">@Model.TotalWithdrawals.ToString("C2")</div>
                <div class="small text-muted">@Model.WithdrawalCount cash payouts</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 rounded border" style="background: @(Model.NetCashFlow >= 0 ? "#ecfdf5" : "#fef2f2");">
                <div class="small text-muted">Net Daily Liquidity Delta</div>
                <div class="fs-4 fw-bold @(Model.NetCashFlow >= 0 ? "text-success" : "text-danger") font-mono">
                    @(Model.NetCashFlow >= 0 ? "+" : "")@Model.NetCashFlow.ToString("C2")
                </div>
                <div class="small text-muted">Net cash position change</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="p-3 rounded border bg-light">
                <div class="small text-muted">Inter-Account Transfers</div>
                <div class="fs-5 fw-bold text-dark font-mono">@Model.TotalTransfers.ToString("C2")</div>
                <div class="small text-muted">@Model.TransferCount cleared transactions</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 rounded border bg-light">
                <div class="small text-muted">New Accounts Activated</div>
                <div class="fs-5 fw-bold text-primary font-mono">@Model.NewAccountsOpened</div>
                <div class="small text-muted">Across retail & commercial branches</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 rounded border bg-light">
                <div class="small text-muted">New Customers Registered</div>
                <div class="fs-5 fw-bold text-primary font-mono">@Model.NewCustomersRegistered</div>
                <div class="small text-muted">Verified KYC onboarding</div>
            </div>
        </div>
    </div>

    <!-- Quick Links to Specialized Reports (No print) -->
    <div class="pt-3 border-top no-print">
        <div class="small fw-bold text-secondary text-uppercase mb-2">Detailed Portfolio Reports:</div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Transactions" class="btn btn-sm btn-outline-primary">
                <i class="fa-solid fa-list-check me-1"></i> Transaction Ledger Report
            </a>
            <a asp-action="Customers" class="btn btn-sm btn-outline-primary">
                <i class="fa-solid fa-users me-1"></i> Customer Portfolio Report
            </a>
            <a asp-action="Accounts" class="btn btn-sm btn-outline-primary">
                <i class="fa-solid fa-vault me-1"></i> Account Portfolio Report
            </a>
            <a asp-action="Loans" class="btn btn-sm btn-outline-primary">
                <i class="fa-solid fa-hand-holding-dollar me-1"></i> Credit & Loan Facilities Report
            </a>
        </div>
    </div>
</div>
