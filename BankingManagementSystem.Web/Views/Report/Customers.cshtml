@model IEnumerable<BankingManagementSystem.Core.Entities.Customer>
@{
    ViewData["Title"] = "Customer Portfolio Report";
}

<div class="page-header no-print">
    <div>
        <h1 class="page-title">Customer Portfolio Report</h1>
        <div class="page-subtitle">KYC customer listings and demographic analysis</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCustomersCsv" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" class="btn btn-outline-success btn-sm px-3">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Filters -->
<div class="bank-card p-3 mb-4 no-print">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">-- All Statuses --</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                <option value="Suspended" selected="@(ViewBag.Status == "Suspended")">Suspended</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" placeholder="From Date" />
        </div>
        <div class="col-md-3">
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" placeholder="To Date" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            <a asp-action="Customers" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="bank-card">
    <div class="bank-table-responsive">
        <table class="bank-table">
            <thead>
                <tr>
                    <th>Customer Code</th>
                    <th>Full Legal Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>National ID</th>
                    <th>Accounts</th>
                    <th>Status</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No customer records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-mono fw-bold text-primary small">@c.CustomerCode</td>
                            <td class="fw-semibold">@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td class="font-mono small">@c.NID</td>
                            <td><span class="badge bg-primary">@c.Accounts.Count</span></td>
                            <td>
                                <span class="badge-status @(c.Status == CustomerStatus.Active ? "badge-active" : "badge-danger")">
                                    @c.Status
                                </span>
                            </td>
                            <td class="small text-muted">@c.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
