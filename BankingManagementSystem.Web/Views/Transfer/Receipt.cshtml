@model BankingManagementSystem.Web.ViewModels.TransferReceiptViewModel
@{
    ViewData["Title"] = $"Transfer Receipt - {Model.TransferReference}";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="page-title">Fund Transfer Settlement Voucher</h1>
        <div class="page-subtitle">Immediate ledger transfer confirmation</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="History" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-list me-1"></i> Transfer History
        </a>
        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print Voucher
        </button>
    </div>
</div>

<div class="receipt-card">
    <div class="receipt-stamp">TRANSFERRED</div>

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.25rem;">
            <i class="fa-solid fa-building-columns"></i>
        </div>
        <div>
            <h4 class="fw-bold mb-0 text-dark">SecureBank Enterprise</h4>
            <div class="small text-muted">Inter-Account Clearing Gateway</div>
        </div>
    </div>

    <div class="receipt-divider"></div>

    <div class="text-center my-4">
        <div class="small text-uppercase text-muted fw-bold mb-1">Transfer Amount</div>
        <div class="display-5 fw-extrabold text-primary font-mono">
            @Model.Amount.ToString("C2")
        </div>
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 mt-2">
            INSTANT CLEARANCE
        </span>
    </div>

    <div class="receipt-divider"></div>

    <table class="table table-borderless small mb-0">
        <tbody>
            <tr>
                <td class="text-muted py-1">Transfer Reference:</td>
                <td class="text-end font-mono fw-bold text-primary py-1">@Model.TransferReference</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Settlement Date:</td>
                <td class="text-end fw-semibold py-1">@Model.Date.ToString("MMMM dd, yyyy HH:mm:ss") UTC</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Sender Account:</td>
                <td class="text-end font-mono fw-bold py-1">@Model.SenderAccountNumber</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Sender Name:</td>
                <td class="text-end fw-semibold text-dark py-1">@Model.SenderCustomerName</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Beneficiary Account:</td>
                <td class="text-end font-mono fw-bold text-primary py-1">@Model.ReceiverAccountNumber</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Beneficiary Name:</td>
                <td class="text-end fw-semibold text-dark py-1">@Model.ReceiverCustomerName</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Narrative:</td>
                <td class="text-end text-dark py-1">@Model.Description</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Settlement Status:</td>
                <td class="text-end text-success fw-bold py-1">@Model.Status</td>
            </tr>
        </tbody>
    </table>

    <div class="receipt-divider"></div>

    <div class="text-center text-muted small mt-4">
        <div>Transferred through SecureBank Real-Time Gross Settlement (RTGS).</div>
        <div style="font-size: 0.72rem;" class="mt-1 font-mono">DIGITAL SIGNATURE VERIFIED &bull; ACID TRANSACTION COMMITTED</div>
    </div>
</div>
