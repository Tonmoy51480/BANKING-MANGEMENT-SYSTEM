@model BankingManagementSystem.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Portal Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="bank-card shadow-lg border-0 overflow-hidden">
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #0f172a, #1e3a8a);">
                    <div class="brand-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">SecureBank Portal</h4>
                    <p class="small text-light opacity-75 mb-0">Authorized Personnel & Customer Sign In</p>
                </div>

                <div class="p-4">
                    <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnurl="@Model.ReturnUrl">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-secondary"></i></span>
                                <input asp-for="Email" id="loginEmail" class="form-control border-start-0" placeholder="name@bank.com" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-secondary"></i></span>
                                <input asp-for="Password" id="loginPassword" type="password" class="form-control border-start-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check d-flex justify-content-between align-items-center">
                            <div>
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In to Portal
                        </button>
                    </form>

                    <!-- Quick Fill Demo Buttons -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="small fw-bold text-secondary text-uppercase mb-2 text-center" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            Quick Demo Sign In (1-Click Fill)
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('admin@bank.com', 'Admin@123')">
                                <span><i class="fa-solid fa-user-shield me-2"></i> Admin</span>
                                <span class="small font-mono opacity-75">admin@bank.com</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('manager@bank.com', 'Employee@123')">
                                <span><i class="fa-solid fa-user-tie me-2"></i> Bank Officer</span>
                                <span class="small font-mono opacity-75">manager@bank.com</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('customer1@bank.com', 'Customer@123')">
                                <span><i class="fa-solid fa-user me-2"></i> Retail Customer</span>
                                <span class="small font-mono opacity-75">customer1@bank.com</span>
                            </button>
                        </div>
                    </div>

                    <div class="text-center mt-3 small text-secondary">
                        New customer? <a asp-action="Register" class="fw-semibold">Apply for Account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, pwd) {
            $('#loginEmail').val(email);
            $('#loginPassword').val(pwd);
        }
    </script>
}
