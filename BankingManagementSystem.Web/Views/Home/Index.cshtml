@{
    ViewData["Title"] = "Enterprise Digital Banking System";
}

<div class="py-5" style="background: radial-gradient(circle at top right, #1e3a8a, #0f172a); color: #fff;">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge bg-primary bg-opacity-75 px-3 py-2 text-uppercase mb-3" style="letter-spacing: 1px;">
                    <i class="fa-solid fa-shield-halved me-1"></i> Tier-1 Core Banking Platform
                </span>
                <h1 class="display-4 fw-extrabold mb-3 text-white tracking-tight" style="font-size: 2.75rem;">
                    Institutional-Grade Banking Management System
                </h1>
                <p class="lead text-light mb-4" style="font-size: 1.15rem; line-height: 1.6; opacity: 0.9;">
                    A comprehensive, layered ASP.NET Core 8 MVC enterprise application demonstrating ACID-compliant transactional processing, role-based authorization, automated account numbering, and secure multi-tier financial operations.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 shadow">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Access Portal
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">
                        <i class="fa-solid fa-user-plus me-2"></i> Open Account
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <!-- Demo Credentials Box -->
                <div class="card border-0 shadow-lg" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.15) !important;">
                    <div class="card-body p-4 text-white">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="fa-solid fa-key text-warning fs-4"></i>
                            <h5 class="fw-bold mb-0">Pre-Configured Demo Credentials</h5>
                        </div>
                        <p class="small text-light mb-3 opacity-75">Click any credential below to quickly explore role-based permissions:</p>

                        <div class="mb-3 p-3 rounded" style="background: rgba(0, 0, 0, 0.25);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-danger">System Administrator</span>
                                <span class="small font-mono text-warning">Admin@123</span>
                            </div>
                            <div class="font-mono small text-light">admin@bank.com</div>
                            <div class="text-white-50" style="font-size: 0.75rem;">Full access to system, approvals, audit trail, reports</div>
                        </div>

                        <div class="mb-3 p-3 rounded" style="background: rgba(0, 0, 0, 0.25);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-primary">Bank Manager / Teller</span>
                                <span class="small font-mono text-warning">Employee@123</span>
                            </div>
                            <div class="font-mono small text-light">manager@bank.com / teller@bank.com</div>
                            <div class="text-white-50" style="font-size: 0.75rem;">Customer onboarding, cash desk deposits & withdrawals</div>
                        </div>

                        <div class="p-3 rounded" style="background: rgba(0, 0, 0, 0.25);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-success">Retail Customer</span>
                                <span class="small font-mono text-warning">Customer@123</span>
                            </div>
                            <div class="font-mono small text-light">customer1@bank.com (to customer5)</div>
                            <div class="text-white-50" style="font-size: 0.75rem;">Online transfers, account statements, loan requests, debit cards</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold tracking-tight">Enterprise Architecture Highlights</h2>
        <p class="text-secondary">Engineered with high standards of data consistency, security, and separation of concerns.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="bank-card h-100 p-4">
                <div class="stat-card-icon icon-blue mb-3">
                    <i class="fa-solid fa-arrows-spin"></i>
                </div>
                <h5 class="fw-bold">Atomic Financial Engine</h5>
                <p class="text-secondary small mb-0">
                    Dual-entry bookkeeping for fund transfers with strict ACID guarantees. Any partial failure immediately triggers a database rollback.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="bank-card h-100 p-4">
                <div class="stat-card-icon icon-emerald mb-3">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <h5 class="fw-bold">Role-Based Security</h5>
                <p class="text-secondary small mb-0">
                    Fine-grained authorization utilizing ASP.NET Core Identity with protected cookie sessions, CSRF token validation, and complete data isolation.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="bank-card h-100 p-4">
                <div class="stat-card-icon icon-purple mb-3">
                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                </div>
                <h5 class="fw-bold">Comprehensive Audit Log</h5>
                <p class="text-secondary small mb-0">
                    Persistent tracking of all transactions, logins, account status transitions, and managerial approvals with timestamp and IP attribution.
                </p>
            </div>
        </div>
    </div>
</div>
