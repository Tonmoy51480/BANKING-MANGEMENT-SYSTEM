@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <div class="display-1 fw-bold text-primary mb-3">404</div>
        <h2 class="fw-bold mb-3">Resource Not Found</h2>
        <p class="text-secondary lead mb-4">
            The banking record, account, or page you requested could not be located on the server.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
            <i class="fa-solid fa-house me-2"></i> Return to Safety
        </a>
    </div>
</div>
