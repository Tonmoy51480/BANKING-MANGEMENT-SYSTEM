@model BankingManagementSystem.Web.ViewModels.TransactionReceiptViewModel
@{
    ViewData["Title"] = $"Receipt - {Model.Reference}";
    var isCredit = Model.TransactionType == "DEPOSIT" || Model.TransactionType == "TRANSFER_IN";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="page-title">Transaction Receipt Voucher</h1>
        <div class="page-subtitle">Settlement reference and customer proof of transaction</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-list me-1"></i> Transaction Ledger
        </a>
        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print Receipt
        </button>
    </div>
</div>

<!-- Receipt Card Container -->
<div class="receipt-card">
    <div class="receipt-stamp">SETTLED</div>

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.25rem;">
            <i class="fa-solid fa-building-columns"></i>
        </div>
        <div>
            <h4 class="fw-bold mb-0 text-dark">SecureBank Enterprise</h4>
            <div class="small text-muted">Electronic Funds Processing Network</div>
        </div>
    </div>

    <div class="receipt-divider"></div>

    <div class="text-center my-4">
        <div class="small text-uppercase text-muted fw-bold mb-1">Transaction Amount</div>
        <div class="display-5 fw-extrabold @(isCredit ? "text-success" : "text-danger") font-mono">
            @(isCredit ? "+" : "-")@Model.Amount.ToString("C2")
        </div>
        <span class="badge @(isCredit ? "bg-success" : "bg-danger") bg-opacity-10 text-@(isCredit ? "success" : "danger") border border-@(isCredit ? "success" : "danger") border-opacity-25 mt-2">
            @Model.TransactionType
        </span>
    </div>

    <div class="receipt-divider"></div>

    <table class="table table-borderless small mb-0">
        <tbody>
            <tr>
                <td class="text-muted py-1">Transaction Reference:</td>
                <td class="text-end font-mono fw-bold text-primary py-1">@Model.Reference</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Date & Time:</td>
                <td class="text-end fw-semibold py-1">@Model.Date.ToString("MMMM dd, yyyy HH:mm:ss") UTC</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Account Number:</td>
                <td class="text-end font-mono fw-bold py-1">@Model.AccountNumber</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Beneficiary / Account Holder:</td>
                <td class="text-end fw-semibold text-dark py-1">@Model.CustomerName</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Balance After Transaction:</td>
                <td class="text-end font-mono fw-bold text-dark py-1">@Model.BalanceAfter.ToString("C2")</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Narrative / Description:</td>
                <td class="text-end text-dark py-1">@(Model.Description ?? "Counter cash transaction")</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Execution Status:</td>
                <td class="text-end text-success fw-bold py-1">@Model.Status</td>
            </tr>
            <tr>
                <td class="text-muted py-1">Handled By:</td>
                <td class="text-end text-secondary small py-1">@Model.PerformedBy</td>
            </tr>
        </tbody>
    </table>

    <div class="receipt-divider"></div>

    <div class="text-center text-muted small mt-4">
        <div>Thank you for banking with SecureBank Enterprise.</div>
        <div style="font-size: 0.72rem;" class="mt-1 font-mono">HASH: SHA256-@(Guid.NewGuid().ToString().Substring(0, 18).ToUpper())</div>
    </div>
</div>
